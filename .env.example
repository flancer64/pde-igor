# Telegram Desk configuration. Never commit TDLib state or live credentials.
PDE_DESK_TELEGRAM__API_HASH=
PDE_DESK_TELEGRAM__API_ID=
PDE_DESK_TELEGRAM__TDLIB_DIRECTORY=./var/telegram/prod

# Personal Digital Embassy Runtime configuration.
# Generate before use: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Never commit or log the generated Person secret.
PDE_RUNTIME__ACCESS_TOKEN_TTL_SECONDS=900
PDE_RUNTIME__AUTHORIZATION_CODE_TTL_SECONDS=120
PDE_RUNTIME__AUTHORIZATION_REQUEST_TTL_SECONDS=300
PDE_RUNTIME__BASE_URL=http://127.0.0.1:3000
PDE_RUNTIME__COOKIE_SECURE=false
PDE_RUNTIME__PERSON_SECRET=
PDE_RUNTIME__OWNER_SESSION_TTL_SECONDS=3600

# PostgreSQL durable-state database.
TEQFW_DB__CLIENT=pg
TEQFW_DB__DATABASE=pde_igor
TEQFW_DB__HOST=127.0.0.1
TEQFW_DB__PASSWORD=
TEQFW_DB__PORT=5432
TEQFW_DB__USER=pde_igor

# Web server configuration loaded from the application root.
TEQFW_WEB__HOST=127.0.0.1
TEQFW_WEB__PORT=3000
TEQFW_WEB__TYPE=http
